{
  "expo": {
    "name": "Uni Carpool",
    "slug": "Driver-Uni-Carpool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/unicarpool-icon.png",
    "scheme": "driverunicarpool",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.unicarpool.app",
      "adaptiveIcon": {
        "backgroundColor": "#14213D",
        "foregroundImage": "./assets/images/unicarpool-icon.png",
        "monochromeImage": "./assets/images/unicarpool-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14213D",
          "image": "./assets/images/unicarpool-splash.png",
          "imageWidth": 280
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
